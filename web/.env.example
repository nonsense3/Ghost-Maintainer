# ── Public (safe for browser via NEXT_PUBLIC_*) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Server-only — never prefix with NEXT_PUBLIC_ ─────────────────────────────
# Supabase service role bypasses RLS; use only in Route Handlers / Server Actions.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# GitHub API (read-only PAT for public repo ingestion)
GITHUB_TOKEN=ghp_...

# Gemma 4 / Ollama Cloud & Edge Models (ollama.com/library)
OLLAMA_HOST=http://127.0.0.1:11434
GEMMA_MODEL=gemma4:31b-cloud
# Options: gemma4:31b-cloud (cloud), gemma4:e2b (edge), gemma4:12b (workstation)

# Optional: remote inference if not using Ollama locally
# GEMMA_API_KEY=
# GEMMA_API_BASE_URL=

# App URL (OAuth redirects, emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000
